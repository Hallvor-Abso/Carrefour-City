# --- Acces au site ---

# Mot de passe partage avec l'equipe du magasin
SITE_PASSWORD=change-moi

# Mot de passe du responsable : ouvre en plus l'espace /admin et l'editeur.
# Doit etre different de SITE_PASSWORD.
# Laisser vide ou supprimer la ligne desactive completement l'espace responsable.
ADMIN_PASSWORD=change-moi-aussi

# Chaine aleatoire longue, sert a signer les cookies de session
# Genere-la avec : openssl rand -base64 32
AUTH_SECRET=une-longue-chaine-aleatoire


# --- Edition des procedures depuis le site ---
# Sans ces variables le site fonctionne, mais l'editeur est en lecture seule :
# les procedures se modifient alors uniquement sur GitHub.

# Jeton GitHub a portee restreinte, droit "Contents" en lecture et ecriture
GITHUB_TOKEN=github_pat_...

# Depot ou sont stockees les fiches
GITHUB_REPO=Hallvor-Abso/Carrefour-City

# Branche a modifier (main par defaut)
GITHUB_BRANCH=main

# Utile seulement pour GitHub Enterprise ou pour tester : par defaut https://api.github.com
# GITHUB_API_URL=
